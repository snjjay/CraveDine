{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=EatKathDB;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True;"
  },


  //"Rules/settings for my login tokens
  // JWT Settings
  // 🔑 SecretKey        → Secret used to sign/verify the JWT
  // 🏭 Issuer          → Who created/issued the token
  // 🎯 Audience        → Who the token is intended for
  // ⏱️ ExpiryInMinutes → How long the token remains valid
  // Program.cs reads these settings when configuring JWT Authentication.

  "JwtSettings": {
    "SecretKey": "ReplaceThisWithA256BitSecretKeyForDevelopmentOnly12345",
    "Issuer": "EatKath.API",
    "Audience": "EatKath.Web",
    "ExpiryInMinutes": 60
  },

  // Logging
  //
  // 📝 Think: "How much information should EatKath write into its logs?"
  //
  // Information → Show normal useful information
  // Warning     → Show warnings and more serious messages
  //

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },


  // AllowedHosts
  //
  // 🌐 Think: "Which host/domain names can access my application?"
  //
  // "*" → Allow all hosts


  "AllowedHosts": "*"
}